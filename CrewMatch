<!-- DASHBOARD -->
<div id="dashboard" class="dashboard">
<nav class="dashNav">
  <div class="dashBrand">♡✈ SKYCONNECTION</div>
  <div class="navLinks">
    <button data-view="discover" class="active">Discover</button>
