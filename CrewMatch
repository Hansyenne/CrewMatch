<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>SkyConnection — Cabin Crew Community</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap');

:root {
    --primary: #991b1b;
    --primary-hover: #7f1d1d;
    --accent: #d97706;
    --bg-cream: #faf7f2;
    --card-bg: #ffffff;
    --text-main: #1c1917;
    --text-muted: #78716c;
    --border: #e7e2dc;
    --soft-pink: #fdf2f2;
    --green: #15803d;
    --shadow-subtle: 0 10px 30px -5px rgba(28, 25, 23, 0.05);
    --shadow-elevated: 0 20px 40px -10px rgba(153, 27, 27, 0.12);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html { touch-action: manipulation; }
body { 
    margin: 0; 
    background: var(--bg-cream); 
    color: var(--text-main); 
    font-family: "Plus Jakarta Sans", sans-serif; 
    -webkit-font-smoothing: antialiased; 
    -moz-osx-font-smoothing: grayscale;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
}

button, input, select, textarea { font: inherit; }
button { cursor: pointer; transition: all 0.2s ease; min-height: 48px; min-width: 48px; }

.hidden { display: none !important; }
.app { min-height: 100vh; }

/* Landing Layout */
.landing { min-height: 100vh; display: grid; grid-template-columns: 48% 52%; background: linear-gradient(135deg, #fffbf7 0%, #f7ebe1 100%); }
.hero { padding: 48px 6vw; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; }
.brand { color: var(--primary); font-weight: 700; font-size: 22px; letter-spacing: -0.5px; display: flex; align-items: center; gap: 8px; }
.brand small { display: block; color: var(--text-muted); font-size: 9px; letter-spacing: 3px; font-weight: 500; margin-top: 2px; }
.hero h1 { font: 600 clamp(40px, 4.5vw, 70px)/1.05 "Playfair Display", serif; color: #291a18; margin: 40px 0 20px; }
.hero h1 i { display: block; color: var(--primary); font-size: 0.65em; font-style: italic; margin-top: 10px; }
.hero > p { max-width: 440px; font-size: 15px; line-height: 1.7; color: var(--text-muted); }

.features { margin-top: 36px; display: grid; gap: 16px; }
.feature { display: flex; gap: 16px; align-items: center; background: rgba(255,255,255,0.6); padding: 14px 16px; border-radius: 14px; border: 1px solid rgba(231, 226, 220, 0.6); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.fi { width: 40px; height: 40px; border-radius: 10px; background: var(--soft-pink); display: grid; place-items: center; color: var(--primary); font-size: 18px; flex-shrink: 0; }
.feature b { font-size: 13px; color: var(--text-main); }
.feature span { display: block; color: var(--text-muted); font-size: 11px; margin-top: 1px; }

.heroquote { font: italic 16px "Playfair Display", serif; color: var(--text-muted); border-left: 2px solid var(--primary); padding-left: 14px; margin-top: 30px; }

.authWrap { padding: 40px 5vw; display: flex; align-items: center; justify-content: center; }
.auth { width: min(650px, 100%); background: var(--card-bg); border: 1px solid var(--border); border-radius: 24px; padding: 36px; box-shadow: var(--shadow-elevated); }
.authHead { display: flex; justify-content: space-between; align-items: flex-start; }
.title { font: 600 28px "Playfair Display", serif; color: var(--text-main); margin: 0; }
.sub { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
.switch { border: 1px solid var(--border); background: #fff; color: var(--primary); padding: 10px 16px; border-radius: 10px; font-weight: 600; font-size: 12px; height: auto; min-height: 40px; }
.switch:hover { background: var(--soft-pink); }

.notice { background: #fffbeb; border: 1px solid #fef3c7; color: #92400e; padding: 12px 14px; border-radius: 12px; font-size: 11px; margin: 14px 0; line-height: 1.5; }
.notice b { display: block; color: #b45309; margin-bottom: 2px; }

.tabs { display: flex; border-bottom: 1px solid var(--border); margin: 20px 0; }
.tab { border: 0; background: none; padding: 12px 16px; color: var(--text-muted); font-weight: 600; font-size: 13px; min-height: 44px; }
.tab.active { color: var(--primary); border-bottom: 2px solid var(--primary); }

.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.two { grid-template-columns: 1fr 1fr; }
h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--primary); margin: 20px 0 8px; font-weight: 700; }
label.field { display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); }
input, select, textarea { width: 100%; border: 1px solid var(--border); border-radius: 10px; background: #fafaf9; padding: 12px 14px; margin-top: 4px; outline: none; font-size: 16px; color: var(--text-main); transition: all 0.2s; -webkit-appearance: none; appearance: none; }
select { background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2378716c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e"); background-repeat: no-repeat; background-position: right 12px center; background-size: 16px; padding-right: 36px; }
input:focus, select:focus, textarea:focus { border-color: var(--primary); background: #fff; box-shadow: 0 0 0 3px rgba(153, 27, 27, 0.08); }

.uploads { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.upload { border: 1px dashed var(--border); border-radius: 12px; padding: 14px; background: #fafaf9; }
.upload b { font-size: 12px; color: var(--text-main); }
.upload small { display: block; color: var(--text-muted); margin: 2px 0 6px; font-size: 10px; }
.upload input { padding: 6px 4px; font-size: 11px; border: none; background: transparent; }

.code { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-top: 8px; align-items: center; }
.verified { padding: 0 14px; height: 48px; border-radius: 10px; border: 1px solid #bbf7d0; background: #f0fdf4; color: var(--green); font-size: 11px; font-weight: 600; display: grid; place-items: center; }
.checks { display: flex; gap: 16px; flex-wrap: wrap; margin: 16px 0; }
.checks label { font-size: 12px; color: var(--text-main); display: flex; align-items: center; gap: 8px; cursor: pointer; min-height: 44px; }
.checks input { width: 20px; height: 20px; margin: 0; }

.mainBtn { width: 100%; border: 0; background: var(--primary); color: #fff; padding: 14px; border-radius: 12px; font-weight: 600; margin-top: 16px; box-shadow: 0 4px 12px rgba(153, 27, 27, 0.2); min-height: 50px; }
.mainBtn:hover { background: var(--primary-hover); transform: translateY(-1px); }
.msg { text-align: center; font-size: 11px; min-height: 16px; margin-top: 8px; font-weight: 500; }
.err { color: var(--primary); } .ok { color: var(--green); }
.loginBox { max-width: 420px; margin: 20px auto; }
.demo { background: #fafaf9; border: 1px solid var(--border); padding: 14px; border-radius: 12px; font-size: 11px; margin-top: 16px; color: var(--text-muted); line-height: 1.6; }
.demo b { color: var(--primary); }

/* Dashboard Experience */
.dashboard { display: none; min-height: 100vh; background: var(--bg-cream); }
.dashNav { height: 74px; background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); display: flex; align-items: center; padding: 0 5vw; gap: 24px; position: sticky; top: 0; z-index: 20; }
.dashBrand { color: var(--primary); font-weight: 800; font-size: 18px; letter-spacing: -0.5px; white-space: nowrap; }
.navLinks { display: flex; gap: 6px; flex: 1; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
.navLinks::-webkit-scrollbar { display: none; }
.navLinks button { border: 0; background: none; color: var(--text-muted); padding: 10px 14px; border-radius: 10px; font-size: 12px; font-weight: 600; white-space: nowrap; min-height: 44px; }
.navLinks button.active, .navLinks button:hover { background: var(--soft-pink); color: var(--primary); }

.avatarMini { width: 40px; height: 40px; border-radius: 50%; background: #e7e2dc; overflow: hidden; display: grid; place-items: center; font-weight: 700; color: var(--primary); border: 2px solid #fff; box-shadow: var(--shadow-subtle); flex-shrink: 0; }
.avatarMini img { width: 100%; height: 100%; object-fit: cover; }

.content { max-width: 1240px; margin: auto; padding: 40px 24px calc(40px + env(safe-area-inset-bottom)); }
.view { display: none; } .view.active { display: block; }
.welcome { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px; }
.welcome h2 { font: 600 32px "Playfair Display", serif; margin: 0; color: var(--text-main); }
.welcome p { color: var(--text-muted); font-size: 13px; margin: 4px 0 0; }

.filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; }
.filter { padding: 10px 16px; border: 1px solid var(--border); border-radius: 10px; background: #fff; color: var(--text-main); font-size: 12px; font-weight: 500; box-shadow: var(--shadow-subtle); min-height: 44px; }
.filter:hover { border-color: var(--primary); color: var(--primary); }

.profiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.profileCard { background: var(--card-bg); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-subtle); transition: transform 0.2s; }
.profileCard:hover { transform: translateY(-3px); box-shadow: var(--shadow-elevated); }
.photo { height: 260px; display: grid; place-items: end start; padding: 16px; background: linear-gradient(145deg, #e7e2dc, #d6cdc4); position: relative; }
.photo img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
.photo .initials { font: 700 52px "Playfair Display", serif; color: #fff; opacity: 0.9; z-index: 1; text-shadow: 0 2px 10px rgba(0,0,0,0.2); }
.online { position: absolute; top: 14px; right: 14px; background: rgba(255,255,255,0.9); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); padding: 4px 10px; border-radius: 20px; font-size: 10px; color: var(--green); font-weight: 700; z-index: 2; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }

.pbody { padding: 16px; }
.pbody h3 { margin: 0 0 4px; color: var(--text-main); font-size: 16px; font-weight: 700; letter-spacing: -0.3px; }
.meta { font-size: 11px; color: var(--text-muted); line-height: 1.5; }
.chips { display: flex; gap: 6px; flex-wrap: wrap; margin: 12px 0; }
.chip { font-size: 10px; font-weight: 500; padding: 5px 10px; background: var(--soft-pink); color: var(--primary); border-radius: 20px; }
.actions { display: flex; gap: 10px; }
.actions button { flex: 1; border: 0; border-radius: 10px; padding: 12px; font-size: 12px; font-weight: 600; min-height: 48px; }
.pass { background: #f5f3f0; color: var(--text-muted); } .pass:hover { background: #e7e2dc; }
.like { background: var(--primary); color: #fff; box-shadow: 0 4px 12px rgba(153, 27, 27, 0.2); } .like:hover { background: var(--primary-hover); }

.empty { background: var(--card-bg); border: 1px dashed var(--border); padding: 50px; text-align: center; border-radius: 20px; color: var(--text-muted); font-size: 13px; }

.cards2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.panel { background: var(--card-bg); border: 1px solid var(--border); border-radius: 20px; padding: 24px; box-shadow: var(--shadow-subtle); }
.panel h3 { margin: 0 0 16px; font-size: 16px; color: var(--text-main); }
.matchList { display: grid; gap: 10px; }
.match { display: flex; align-items: center; gap: 12px; padding: 10px; background: #fafaf9; border-radius: 12px; border: 1px solid var(--border); }
.mavatar { width: 44px; height: 44px; border-radius: 50%; background: #e7e2dc; overflow: hidden; display: grid; place-items: center; color: var(--primary); font-weight: 700; flex-shrink: 0; }
.mavatar img { width: 100%; height: 100%; object-fit: cover; }
.match b { font-size: 13px; color: var(--text-main); }
.match small { display: block; color: var(--text-muted); font-size: 11px; }
.match button { margin-left: auto; border: 0; background: var(--primary); color: #fff; border-radius: 8px; padding: 8px 14px; font-size: 11px; font-weight: 600; min-height: 40px; }

.events { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.event { background: var(--card-bg); border: 1px solid var(--border); border-radius: 20px; padding: 20px; box-shadow: var(--shadow-subtle); display: flex; flex-direction: column; justify-content: space-between; }
.date { color: var(--primary); font-weight: 700; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; }
.event h3 { color: var(--text-main); margin: 8px 0; font-size: 16px; }
.event p { font-size: 12px; color: var(--text-muted); line-height: 1.6; margin-bottom: 16px; }
.event button { border: 0; background: var(--soft-pink); color: var(--primary); padding: 10px 14px; border-radius: 10px; font-weight: 600; font-size: 11px; width: fit-content; min-height: 40px; }
.event button:hover { background: var(--primary); color: #fff; }

.chat { display: grid; grid-template-columns: 320px 1fr; height: 620px; background: var(--card-bg); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-subtle); }
.chatList { border-right: 1px solid var(--border); padding: 16px; overflow-y: auto; -webkit-overflow-scrolling: touch; background: #fafaf9; }
.chatItem { padding: 12px; border-radius: 12px; display: flex; gap: 12px; align-items: center; cursor: pointer; transition: background 0.15s; min-height: 60px; }
.chatItem.active, .chatItem:hover { background: #fff; box-shadow: var(--shadow-subtle); }
.chatWindow { display: flex; flex-direction: column; }
.chatHead { padding: 18px 24px; border-bottom: 1px solid var(--border); font-weight: 700; font-size: 15px; background: #fff; }
.messages { flex: 1; padding: 24px; overflow-y: auto; -webkit-overflow-scrolling: touch; display: flex; flex-direction: column; gap: 12px; background: #fafaf9; }
.bubble { max-width: 65%; padding: 12px 16px; border-radius: 14px; background: #fff; border: 1px solid var(--border); font-size: 13px; line-height: 1.5; color: var(--text-main); }
.bubble.me { align-self: flex-end; background: var(--primary); color: #fff; border: none; }
.chatInput { display: flex; gap: 10px; padding: 16px 20px; border-top: 1px solid var(--border); background: #fff; }
.chatInput input { margin: 0; font-size: 14px; }
.chatInput button { border: 0; background: var(--primary); color: #fff; border-radius: 10px; padding: 0 20px; font-weight: 600; font-size: 12px; min-height: 48px; }

.profilePanel { display: grid; grid-template-columns: 280px 1fr; gap: 24px; }
.profileHero { background: linear-gradient(135deg, #e7e2dc, #d6cdc4); height: 320px; border-radius: 20px; overflow: hidden; display: grid; place-items: center; color: var(--primary); font: 700 70px "Playfair Display"; border: 1px solid var(--border); box-shadow: var(--shadow-subtle); }
.profileHero img { width: 100%; height: 100%; object-fit: cover; }
.settings { display: grid; gap: 10px; }
.danger { background: var(--soft-pink); border: 1px solid #fecaca; color: var(--primary); padding: 12px; border-radius: 12px; font-size: 12px; font-weight: 600; text-align: left; min-height: 48px; display: grid; align-items: center; }
.danger:hover { background: var(--primary); color: #fff; }

/* Modal Styles */
.modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(28, 25, 23, 0.4); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); display: grid; place-items: center; z-index: 100; opacity: 0; pointer-events: none; transition: opacity 0.2s ease; padding: 20px; }
.modal-overlay.show { opacity: 1; pointer-events: auto; }
.modal-content { background: var(--card-bg); width: min(500px, 100%); padding: 30px; border-radius: 24px; border: 1px solid var(--border); box-shadow: var(--shadow-elevated); max-height: 90vh; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.modal-header h3 { margin: 0; font-size: 20px; font-family: "Playfair Display", serif; color: var(--text-main); }
.close-modal { background: none; border: none; font-size: 22px; color: var(--text-muted); cursor: pointer; min-height: 44px; min-width: 44px; display: grid; place-items: center; }

.toast { position: fixed; right: 20px; bottom: 20px; background: var(--text-main); color: #fff; padding: 14px 20px; border-radius: 12px; font-size: 12px; font-weight: 500; opacity: 0; transform: translateY(10px); transition: all 0.25s ease; z-index: 999; box-shadow: var(--shadow-elevated); }
.toast.show { opacity: 1; transform: none; }

@media(max-width: 1000px) {
  .landing { grid-template-columns: 1fr; }
  .hero { min-height: 500px; padding: 32px 5vw; }
  .profiles { grid-template-columns: repeat(2, 1fr); }
  .events { grid-template-columns: 1fr 1fr; }
  .profilePanel { grid-template-columns: 1fr; }
}
@media(max-width: 650px) {
  .grid, .two, .uploads { grid-template-columns: 1fr; }
  .profiles, .events, .cards2 { grid-template-columns: 1fr; }
  .dashNav { gap: 12px; padding: 0 16px; height: 64px; }
  .content { padding: 24px 16px; }
  .chat { grid-template-columns: 1fr; height: 500px; }
  .chatList { display: none; }
}
</style>
</head>
<body>

<!-- AUTH EXPERIENCE -->
<div id="landing" class="landing">
<section class="hero">
<div>
<div class="brand">♡✈ SKYCONNECTION<small>CABIN CREW COMMUNITY</small></div>
<h1>More Than<br>Just Dating.<i>It's a Lifestyle.</i></h1>
<p>A private community created exclusively for cabin crew — for dating, genuine friendships, curated gatherings, lifestyle activities, and the people who truly understand the aviation schedule.</p>
</div>
<div class="features">
<div class="feature"><div class="fi">♡</div><div><b>Find Connections</b><span>Meet verified crew open to genuine relationships.</span></div></div>
<div class="feature"><div class="fi">♧</div><div><b>Make Friends</b><span>Build a global network across top international carriers.</span></div></div>
<div class="feature"><div class="fi">◫</div><div><b>Gatherings & Events</b><span>Discover crew dinners, layover meetups and brunches.</span></div></div>
</div><div class="heroquote">“We don't just connect flights, we connect hearts.”</div>
</section>

<section class="authWrap">
<div class="auth">
<div class="authHead"><div><h2 class="title" id="authTitle">Create Your Account</h2><div class="sub" id="authSub">Join the exclusive global cabin crew network</div></div><button class="switch" id="switchBtn">Log In</button></div>
<div class="tabs"><button class="tab active" id="signupTab">Sign Up</button><button class="tab" id="loginTab">Log In</button></div>

<div id="signupBox">
<div class="notice"><b>Verification Required</b>Upload a valid airline Facecard or Platinum Card with your staff ID. Bypassed instantly with an official verification code.</div>
<form id="signupForm">
<h3>Account Credentials</h3>
<div class="grid two">
<label class="field">Email<input required type="email" name="email" placeholder="you@airline.com"></label>
<label class="field">Password<input required type="password" name="password" minlength="6" placeholder="Min. 6 characters"></label>
</div>

<h3>Personal Information</h3>
<div class="grid">
<label class="field">First Name<input required name="first" placeholder="First Name"></label>
<label class="field">Last Name<input required name="last" placeholder="Last Name"></label>
<label class="field">Date of Birth<input required type="date" name="dob"></label>
</div>
<div class="grid two" style="margin-top:10px">
<label class="field">Gender
  <select required name="gender">
    <option value="">Select Gender</option>
    <option value="Woman">Woman</option>
    <option value="Man">Man</option>
    <option value="Non-binary">Non-binary</option>
    <option value="Prefer not to say">Prefer not to say</option>
  </select>
</label>
<label class="field">Nationality
  <select required name="nationality">
    <option value="">Select Nationality</option>
    <option value="American">American</option>
    <option value="Argentine">Argentine</option>
    <option value="Australian">Australian</option>
    <option value="Bangladeshi">Bangladeshi</option>
    <option value="Brazilian">Brazilian</option>
    <option value="British">British</option>
    <option value="Canadian">Canadian</option>
    <option value="Chinese">Chinese</option>
    <option value="Colombian">Colombian</option>
    <option value="Egyptian">Egyptian</option>
    <option value="Emirati">Emirati</option>
    <option value="Ethiopian">Ethiopian</option>
    <option value="French">French</option>
    <option value="German">German</option>
    <option value="Indian">Indian</option>
    <option value="Indonesian">Indonesian</option>
    <option value="Italian">Italian</option>
    <option value="Japanese">Japanese</option>
    <option value="Kenyan">Kenyan</option>
    <option value="Lebanese">Lebanese</option>
    <option value="Mexican">Mexican</option>
    <option value="Nigerian">Nigerian</option>
    <option value="Pakistani">Pakistani</option>
    <option value="Philippine">Philippine</option>
    <option value="Polish">Polish</option>
    <option value="Portuguese">Portuguese</option>
    <option value="Russian">Russian</option>
    <option value="Saudi">Saudi</option>
    <option value="South African">South African</option>
    <option value="South Korean">South Korean</option>
    <option value="Spanish">Spanish</option>
    <option value="Turkish">Turkish</option>
    <option value="Vietnamese">Vietnamese</option>
    <option value="Other">Other</option>
  </select>
</label>
</div>

<h3>Cabin Crew Details</h3>
<div class="grid">
<label class="field">Airline
  <select required name="airline">
    <option value="">Select Airline</option>
    <option value="Emirates">Emirates</option>
    <option value="Etihad Airways">Etihad Airways</option>
    <option value="Qatar Airways">Qatar Airways</option>
    <option value="flydubai">flydubai</option>
    <option value="Other">Other</option>
  </select>
</label>
<label class="field">Staff Number<input required name="staff" placeholder="Staff ID"></label>
<label class="field">Role
  <select required name="role">
    <option value="">Select Role</option>
    <option value="Cabin Crew">Cabin Crew</option>
    <option value="Senior Cabin Crew">Senior Cabin Crew</option>
    <option value="Purser">Purser</option>
    <option value="Former Cabin Crew">Former Cabin Crew</option>
  </select>
</label>
</div>

<h3>Profile Photo</h3>
<label class="field" style="margin-top:0">Custom Picture URL (Optional)
  <input type="url" name="avatarUrl" placeholder="Leave blank to auto-assign a stunning curated photo">
</label>

<h3>Verification Document <small>(Provide one)</small></h3>
