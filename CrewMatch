</form>
</div>

<div id="loginBox" class="loginBox hidden">
<div class="notice"><b>Welcome Back</b>Log in securely to connect with verified colleagues across global destinations.</div>
<form id="loginForm">
<label class="field">Email<input required id="loginEmail" type="email" placeholder="you@airline.com"></label>
<label class="field" style="display:block;margin-top:12px">Password<input required id="loginPassword" type="password" placeholder="Your password"></label>
<button class="mainBtn">Log In</button>
<div id="loginMsg" class="msg"></div>
</form>
<div class="demo"><b>Demo Accounts</b><br>alex@skyconnection.demo / demo123<br>sofia@skyconnection.demo / demo123<br><br><b>Admin Prototype:</b> admin@skyconnection.demo / admin123</div>
</div>
