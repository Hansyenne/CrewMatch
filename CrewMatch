<!-- EDIT PROFILE MODAL -->
<div id="editModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Edit Your Profile</h3>
      <button class="close-modal" onclick="closeEditModal()">&times;</button>
    </div>
    <form id="editForm">
      <label class="field">Full Name<input required id="editName" name="name"></label>
      <label class="field" style="margin-top:12px">Base / Location<input required id="editLocation" name="location"></label>
      <label class="field" style="margin-top:12px">Role<select id="editRole" name="role"><option>Cabin Crew</option><option>Senior Cabin Crew</option><option>Purser</option><option>Former Cabin Crew</option></select></label>
      <label class="field" style="margin-top:12px">Profile Picture URL<input id="editAvatar" name="avatar" placeholder="https://..."></label>
      <label class="field" style="margin-top:12px">About You<textarea id="editAbout" name="about" rows="3"></textarea></label>
      <button type="submit" class="mainBtn" style="margin-top:20px">Save Changes</button>
    </form>
  </div>
</div>

<div id="toast" class="toast"></div>

<script>
const VERIFY_CODE="XCOM269";

const femaleAvatars = [
    "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400",
    "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=400",
    "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400",
    "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=400",
    "https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=400",
    "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400"
];

const maleAvatars = [
    "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400",
    "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400",
    "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=400",
    "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=400",
    "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400",
    "https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=400"
];

const neutralAvatars = [
    "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=400"
];

const demoUsers=[
{id:"u1",email:"alex@skyconnection.demo",password:"demo123",name:"Alex Morgan",age:29,gender:"Man",nationality:"British",airline:"Emirates",role:"Senior Cabin Crew",location:"Dubai",tags:["Travel","Fitness","Coffee"],verified:true,online:true,avatar:maleAvatars[0],about:"Always looking for a great layover, good coffee and better company."},
{id:"u2",email:"sofia@skyconnection.demo",password:"demo123",name:"Sofia Laurent",age:27,gender:"Woman",nationality:"French",airline:"Etihad Airways",role:"Cabin Crew",location:"Abu Dhabi",tags:["Food","Beach","Photography"],verified:true,online:true,avatar:femaleAvatars[0],about:"French soul, UAE base. Love exploring new places between flights."},
{id:"u3",email:"liam@skyconnection.demo",password:"demo123",name:"Liam Carter",age:31,gender:"Man",nationality:"Australian",airline:"Qatar Airways",role:"Purser",location:"Doha",tags:["Running","Aviation","Music"],verified:true,online:false,avatar:maleAvatars[1],about:"Purser by day, amateur DJ by night."},
{id:"u4",email:"mia@skyconnection.demo",password:"demo123",name:"Mia Santos",age:28,gender:"Woman",nationality:"Philippine",airline:"Emirates",role:"Cabin Crew",location:"Dubai",tags:["Yoga","Brunch","Art"],verified:true,online:true,avatar:femaleAvatars[1],about:"Collecting passport stamps and finding the best brunch spots."},
{id:"u5",email:"noah@skyconnection.demo",password:"demo123",name:"Noah Williams",age:34,gender:"Man",nationality:"American",airline:"Etihad Airways",role:"Senior Cabin Crew",location:"Dubai",tags:["Cars","Gym","Travel"],verified:true,online:false,avatar:maleAvatars[2],about:"Weekend road trips and long-haul stories."},
{id:"u6",email:"emma@skyconnection.demo",password:"demo123",name:"Emma Rossi",age:30,gender:"Woman",nationality:"Italian",airline:"flydubai",role:"Cabin Crew",location:"Dubai",tags:["Cooking","Dogs","Beach"],verified:true,online:true,avatar:femaleAvatars[2],about:"Food lover with a soft spot for sunset flights."},
{id:"u7",email:"daniel@skyconnection.demo",password:"demo123",name:"Daniel Kim",age:26,gender:"Man",nationality:"South Korean",airline:"Emirates",role:"Cabin Crew",location:"Dubai",tags:["Gaming","Sushi","Gym"],verified:true,online:true,avatar:maleAvatars[3],about:"I know every good sushi place in Dubai."},
{id:"u8",email:"clara@skyconnection.demo",password:"demo123",name:"Clara Evans",age:33,gender:"Woman",nationality:"British",airline:"Qatar Airways",role:"Purser",location:"Doha",tags:["Books","Coffee","Hiking"],verified:true,online:false,avatar:femaleAvatars[3],about:"Books, mountains and a quiet coffee after a busy flight."}
];

const events=[
["SEP 12","Crew Sunset Dinner","Dubai · 7:30 PM","A relaxed evening for verified crew members to meet, eat and connect over incredible food."],
["SEP 20","Beach & Brunch","Jumeirah · 10:30 AM","Brunch followed by a beach afternoon with flight crew from multiple international airlines."],
["OCT 03","Layover Stories Night","Dubai · 8:00 PM","Funny, strange and unforgettable aviation stories shared over drinks and dinner."]
];

const activities=[
["✈","Destination Swap","Tell us your favourite layover city and meet someone who loves exploring it too."],
["☕","Coffee Crew","Small coffee meet-ups designed for crew who prefer casual daytime conversations."],
["🏃","Crew Fitness","Running, gym and wellness groups structured around shifting roster schedules."],
["📷","Aviation Photography","Share airport architecture, dramatic wing views and travel tips."],
["🍽","Food Explorers","Discover hidden gem restaurants together when your roster grants a free evening."],
["🎨","Creative Crew","Art, music, books and creative pursuits with like-minded aviation colleagues."]
];

let users=[...demoUsers,...JSON.parse(localStorage.getItem("sky_users")||"[]")];
let current=null, liked=JSON.parse(localStorage.getItem("sky_likes")||"[]"), chats=JSON.parse(localStorage.getItem("sky_chats")||"{}"), activeChat=null;

const $=id=>document.getElementById(id);
function save(){
  localStorage.setItem("sky_users",JSON.stringify(users.filter(u=>!demoUsers.find(d=>d.id===u.id))));
  localStorage.setItem("sky_likes",JSON.stringify(liked));
  localStorage.setItem("sky_chats",JSON.stringify(chats));
}
function toast(t){$("toast").textContent=t;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),2200)}
function initials(n){return n.split(" ").map(x=>x[0]).join("").slice(0,2).toUpperCase()}

function showLogin(){ $("signupBox").classList.add("hidden");$("loginBox").classList.remove("hidden");$("signupTab").classList.remove("active");$("loginTab").classList.add("active");$("authTitle").textContent="Welcome Back";$("authSub").textContent="Log in securely to your cabin crew profile"}
function showSignup(){ $("loginBox").classList.add("hidden");$("signupBox").classList.remove("hidden");$("loginTab").classList.remove("active");$("signupTab").classList.add("active");$("authTitle").textContent="Create Your Account";$("authSub").textContent="Join the exclusive global cabin crew network"}
$("switchBtn").onclick=()=>{$("loginBox").classList.contains("hidden")?showLogin():showSignup()};
$("loginTab").onclick=showLogin;$("signupTab").onclick=showSignup;
$("verifyCode").addEventListener("input",e=>{const ok=e.target.value.trim().toUpperCase()===VERIFY_CODE;$("verifyStatus").textContent=ok?"✓ Verified":"Pending";$("verifyStatus").style.color=ok?"var(--green)":"var(--text-muted)";$("verifyStatus").style.borderColor=ok?"#bbf7d0":"var(--border)"});

$("signupForm").onsubmit=e=>{
  e.preventDefault();const f=new FormData(e.target), code=$("verifyCode").value.trim().toUpperCase(), face=f.get("facecard"),plat=f.get("platinum");
  if(code!==VERIFY_CODE && (!face||!face.name)&&(!plat||!plat.name)){return setMsg("signupMsg","Upload a verification document or enter the authorized code.","err")}
  const purposes=[...document.querySelectorAll('input[name="purpose"]:checked')].map(x=>x.value);if(!purposes.length)return setMsg("signupMsg","Select at least one intent.","err");
  if(users.some(u=>u.email.toLowerCase()===f.get("email").toLowerCase()))return setMsg("signupMsg","An account with this email already exists.","err");

  let avatarUrl = f.get("avatarUrl").trim();
  if(!avatarUrl) {
    let gender = f.get("gender").toLowerCase();
    let pool = neutralAvatars;
    if(gender.includes("woman")||gender.includes("female")) pool = femaleAvatars;
    else if(gender.includes("man")||gender.includes("male")) pool = maleAvatars;
    avatarUrl = pool[Math.floor(Math.random() * pool.length)];
  }

  const u={id:"user_"+Date.now(),email:f.get("email"),password:f.get("password"),name:f.get("first")+" "+f.get("last"),age:calcAge(f.get("dob")),gender:f.get("gender"),nationality:f.get("nationality"),airline:f.get("airline"),role:f.get("role"),location:f.get("location")||"Dubai",tags:purposes,verified:code===VERIFY_CODE,online:true,avatar:avatarUrl,about:"New SkyConnection community member."};
  users.push(u);save();current=u;openDashboard();setMsg("signupMsg","Account created successfully!","ok");
};

function calcAge(d){if(!d)return 25;let x=new Date(d),n=new Date();let a=n.getFullYear()-x.getFullYear();if(n.getMonth()<x.getMonth()||(n.getMonth()===x.getMonth()&&n.getDate()<x.getDate()))a--;return a}
function setMsg(id,t,c){$(id).textContent=t;$(id).className="msg "+c}

$("loginForm").onsubmit=e=>{e.preventDefault();const em=$("loginEmail").value.trim().toLowerCase(),pw=$("loginPassword").value;const u=users.find(x=>x.email.toLowerCase()===em&&x.password===pw);if(!u)return setMsg("loginMsg","Incorrect email or password.","err");current=u;openDashboard()};

function openDashboard(){
  $("landing").style.display="none";
  $("dashboard").style.display="block";
  updateNavAvatar();
  renderAll();
  window.scrollTo(0,0);
}

function updateNavAvatar(){
  if(current.avatar){
    $("navAvatar").innerHTML=`<img src="${current.avatar}" alt="Avatar">`;
  } else {
    $("navAvatar").textContent=initials(current.name);
  }
}

function renderAll(){renderDiscover();renderMatches();renderChats();renderEvents();renderActivities();renderProfile()}

document.querySelectorAll(".navLinks button").forEach(b=>b.onclick=()=>{
  document.querySelectorAll(".navLinks button").forEach(x=>x.classList.remove("active"));
  b.classList.add("active");
  document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));
  $(b.dataset.view).classList.add("active");
  if(b.dataset.view==="messages") renderChats();
});

function renderDiscover(){
  const others=users.filter(u=>u.id!==current.id);
  $("profileGrid").innerHTML=others.map(u=>`
    <article class="profileCard">
      <div class="photo">
        ${u.avatar?`<img src="${u.avatar}" alt="${u.name}">`:''}
        <div class="initials">${initials(u.name)}</div>
        ${u.online?'<span class="online">● Online</span>':''}
      </div>
      <div class="pbody">
        <h3>${u.name}, ${u.age}</h3>
        <div class="meta">✓ Verified · ${u.role}<br>${u.airline} · ${u.location}</div>
        <div class="chips">${u.tags.map(t=>`<span class="chip">${t}</span>`).join("")}</div>
        <div class="actions">
          <button class="pass" onclick="passUser('${u.id}')">Pass</button>
          <button class="like" onclick="likeUser('${u.id}')">♡ Like</button>
        </div>
      </div>
    </article>
  `).join("");
}

function likeUser(id){if(!liked.includes(id))liked.push(id);save();const u=users.find(x=>x.id===id);toast(`Liked ${u.name.split(" ")[0]} ♡`);renderMatches()}
function passUser(id){toast("Profile passed");const card=[...document.querySelectorAll(".profileCard")].find(x=>x.innerText.includes(users.find(u=>u.id===id).name));if(card)card.remove()}

function renderMatches(){
  const list=users.filter(u=>liked.includes(u.id));
  $("matchesList").innerHTML=list.length?list.map(u=>`
    <div class="match">
      <div class="mavatar">${u.avatar?`<img src="${u.avatar}" alt="">`:initials(u.name)}</div>
      <div><b>${u.name}</b><small>${u.airline} · ${u.location}</small></div>
      <button onclick="startChat('${u.id}')">Message</button>
    </div>
  `).join(""):'<div class="empty">Like members in Discover to establish matches.</div>';
}

function startChat(id){activeChat=id;document.querySelector('[data-view="messages"]').click();renderChats()}

function renderChats(){
  const list=users.filter(u=>liked.includes(u.id));
  $("chatList").innerHTML=list.length?list.map(u=>`
    <div class="chatItem ${activeChat===u.id?'active':''}" onclick="activeChat='${u.id}';renderChats()">
      <div class="mavatar">${u.avatar?`<img src="${u.avatar}" alt="">`:initials(u.name)}</div>
      <div>
        <b style="font-size:12px;color:var(--text-main)">${u.name}</b>
        <small style="display:block;color:var(--text-muted);font-size:10px">${(chats[u.id]?.slice(-1)[0]?.text)||"Start a conversation"}</small>
      </div>
    </div>
  `).join(""):'<div class="empty" style="padding:30px">No active conversations.</div>';

  if(!activeChat&&list.length) activeChat=list[0].id;
  const u=users.find(x=>x.id===activeChat);
  $("chatHead").textContent=u?u.name:"Select a conversation";
  const arr=chats[activeChat]||[];
  $("messages").innerHTML=arr.map(m=>`<div class="bubble ${m.me?'me':''}">${escapeHtml(m.text)}</div>`).join("");
  $("messages").scrollTop=$("messages").scrollHeight;
}

$("sendBtn").onclick=sendMessage;$("chatInput").addEventListener("keydown",e=>{if(e.key==="Enter")sendMessage()});
function sendMessage(){
  const text=$("chatInput").value.trim();if(!text||!activeChat)return;
  if(!chats[activeChat]) chats[activeChat]=[];
  chats[activeChat].push({me:true,text});save();$("chatInput").value="";renderChats();
  setTimeout(()=>{
    chats[activeChat].push({me:false,text:`Hey ${current.name.split(" ")[0]}! Great connecting with you. ✈️`});
    save();renderChats();
  },700);
}

function escapeHtml(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function renderEvents(){$("eventsGrid").innerHTML=events.map(e=>`<article class="event"><div class="date">${e[0]}</div><h3>${e[1]}</h3><div style="font-size:11px;color:var(--primary);font-weight:600;margin-bottom:6px">${e[2]}</div><p>${e[3]}</p><button onclick="toast('You are on the guest list for ${e[1]}')">Join Gathering</button></article>`).join("")}
function renderActivities(){$("activitiesGrid").innerHTML=activities.map(a=>`<article class="event"><div style="font-size:28px;margin-bottom:8px">${a[0]}</div><h3>${a[1]}</h3><p>${a[2]}</p><button onclick="toast('Activity joined successfully!')">Join Activity</button></article>`).join("")}

function renderProfile(){
  if(current.avatar){
    $("profileHero").innerHTML=`<img src="${current.avatar}" alt="Profile Hero">`;
  } else {
    $("profileHero").textContent=initials(current.name);
  }
  $("profileName").textContent=current.name;
  $("profileDetails").innerHTML=`
    <b style="color:var(--text-main);font-size:14px">${current.age} · ${current.role}</b><br>
    ✓ Verified Cabin Crew Member<br>
    ${current.airline} · Base: ${current.location}<br>
    Nationality: ${current.nationality || "Not specified"}<br><br>
    ${current.about}<br><br>
    <b>Interests & Intentions</b><br>
    ${current.tags.map(t=>`<span class="chip" style="display:inline-block;margin:6px 4px 0 0">${t}</span>`).join("")}
  `;
}

function openEditModal(){
  $("editName").value = current.name;
  $("editLocation").value = current.location;
  $("editRole").value = current.role;
  $("editAvatar").value = current.avatar || "";
  $("editAbout").value = current.about;
  $("editModal").classList.add("show");
}

function closeEditModal(){
  $("editModal").classList.remove("show");
}

$("editForm").onsubmit = e => {
  e.preventDefault();
  current.name = $("editName").value;
  current.location = $("editLocation").value;
  current.role = $("editRole").value;
  let newAvatar = $("editAvatar").value.trim();
  if(newAvatar) current.avatar = newAvatar;
  current.about = $("editAbout").value;

  const idx = users.findIndex(u=>u.id===current.id);
  if(idx !== -1) users[idx] = current;
  save();
  updateNavAvatar();
  renderProfile();
  closeEditModal();
  toast("Profile updated successfully!");
};

function logout(){
  current=null;activeChat=null;
  $("dashboard").style.display="none";
  $("landing").style.display="grid";
  showLogin();
  toast("Logged out securely");
}
</script>
</body>
</html>
