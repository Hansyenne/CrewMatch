</section>

<section id="profile" class="view">
<div class="welcome"><div><h2>My Profile</h2><p>Manage your account settings and personal presentation.</p></div></div>
<div class="profilePanel">
  <div class="profileHero" id="profileHero">A</div>
  <div class="panel">
    <h3 id="profileName">Your Profile</h3>
    <div id="profileDetails" style="font-size:13px;line-height:1.8;color:var(--text-muted)"></div>
    <hr style="border:0;border-top:1px solid var(--border);margin:20px 0">
    <div class="settings">
      <button class="filter" onclick="openEditModal()" style="width:100%;text-align:center;">Edit Profile</button>
      <button class="filter" onclick="toast('Privacy settings preferences saved.')">Privacy Settings</button>
