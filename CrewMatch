$("switchBtn").onclick=()=>{$("loginBox").classList.contains("hidden")?showLogin():showSignup()};
$("loginTab").onclick=showLogin;$("signupTab").onclick=showSignup;
$("verifyCode").addEventListener("input",e=>{const ok=e.target.value.trim().toUpperCase()===VERIFY_CODE;$("verifyStatus").textContent=ok?"✓ Verification Skipped":"Verification pending";$("verifyStatus").style.color=ok?"var(--green)":"var(--muted)"});

$("signupForm").onsubmit=e=>{
e.preventDefault();const f=new FormData(e.target), code=$("verifyCode").value.trim().toUpperCase(), face=f.get("facecard"),plat=f.get("platinum");
if(code!==VERIFY_CODE && (!face||!face.name)&&(!plat||!plat.name)){return setMsg("signupMsg","Upload a Facecard or Platinum Card, or enter the authorized verification code.","err")}
const purposes=[...document.querySelectorAll('input[name="purpose"]:checked')].map(x=>x.value);if(!purposes.length)return setMsg("signupMsg","Select at least one purpose.","err");
if(users.some(u=>u.email.toLowerCase()===f.get("email").toLowerCase()))return setMsg("signupMsg","An account with this email already exists.","err");
const u={id:"user_"+Date.now(),email:f.get("email"),password:f.get("password"),name:f.get("first")+" "+f.get("last"),age:calcAge(f.get("dob")),gender:f.get("gender"),airline:f.get("airline"),role:f.get("role"),location:f.get("location")||"Not specified",tags:purposes,verified:code===VERIFY_CODE,online:true,about:"New SkyConnection member."};
users.push(u);save();current=u;openDashboard();setMsg("signupMsg",code===VERIFY_CODE?"Account created and verification skipped.":"Application submitted. Verification can take up to 48 hours.","ok")
};
function calcAge(d){if(!d)return 25;let x=new Date(d),n=new Date();let a=n.getFullYear()-x.getFullYear();if(n.getMonth()<x.getMonth()||(n.getMonth()===x.getMonth()&&n.getDate()<x.getDate()))a--;return a}
function setMsg(id,t,c){$(id).textContent=t;$(id).className="msg "+c}

$("loginForm").onsubmit=e=>{e.preventDefault();const em=$("loginEmail").value.trim().toLowerCase(),pw=$("loginPassword").value;const u=users.find(x=>x.email.toLowerCase()===em&&x.password===pw);if(!u)return setMsg("loginMsg","Incorrect email or password.","err");current=u;openDashboard()};
function openDashboard(){ $("landing").style.display="none";$("dashboard").style.display="block";$("navAvatar").textContent=initials(current.name);renderAll();window.scrollTo(0,0)}
function renderAll(){renderDiscover();renderMatches();renderChats();renderEvents();renderActivities();renderProfile()}
document.querySelectorAll(".navLinks button").forEach(b=>b.onclick=()=>{document.querySelectorAll(".navLinks button").forEach(x=>x.classList.remove("active"));b.classList.add("active");document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));$(b.dataset.view).classList.add("active");if(b.dataset.view==="messages")renderChats()});
function renderDiscover(){const others=users.filter(u=>u.id!==current.id);$("profileGrid").innerHTML=others.map(u=>`<article class="profileCard"><div class="photo"><div class="initials">${initials(u.name)}</div>${u.online?'<span class="online">● Online</span>':''}</div><div class="pbody"><h3>${u.name}, ${u.age}</h3><div class="meta">✓ Verified · ${u.role}<br>${u.airline} · ${u.location}</div><div class="chips">${u.tags.map(t=>`<span class="chip">${t}</span>`).join("")}</div><div class="actions"><button class="pass" onclick="passUser('${u.id}')">Pass</button><button class="like" onclick="likeUser('${u.id}')">♡ Like</button></div></div></article>`).join("")}
function likeUser(id){if(!liked.includes(id))liked.push(id);save();const u=users.find(x=>x.id===id);toast(`You liked ${u.name.split(" ")[0]} ♡`);renderMatches()}
function passUser(id){toast("Profile passed");const card=[...document.querySelectorAll(".profileCard")].find(x=>x.innerText.includes(users.find(u=>u.id===id).name));if(card)card.remove()}
function renderMatches(){const list=users.filter(u=>liked.includes(u.id));$("matchesList").innerHTML=list.length?list.map(u=>`<div class="match"><div class="mavatar">${initials(u.name)}</div><div><b>${u.name}</b><small>${u.airline} · ${u.location}</small></div><button onclick="startChat('${u.id}')">Message</button></div>`).join(""):'<div class="empty">Like people in Discover to build your matches.</div>'}
function startChat(id){activeChat=id;document.querySelector('[data-view="messages"]').click();renderChats()}
function renderChats(){const list=users.filter(u=>liked.includes(u.id));$("chatList").innerHTML=list.length?list.map(u=>`<div class="chatItem ${activeChat===u.id?'active':''}" onclick="activeChat='${u.id}';renderChats()"><div class="mavatar">${initials(u.name)}</div><div><b style="font-size:11px">${u.name}</b><small style="display:block;color:var(--muted);font-size:9px">${(chats[u.id]?.slice(-1)[0]?.text)||"Start a conversation"}</small></div></div>`).join(""):'<div class="empty" style="padding:25px">No conversations yet.</div>';
if(!activeChat&&list.length)activeChat=list[0].id;
const u=users.find(x=>x.id===activeChat);$("chatHead").textContent=u?u.name:"Select a conversation";const arr=chats[activeChat]||[];$("messages").innerHTML=arr.map(m=>`<div class="bubble ${m.me?'me':''}">${escapeHtml(m.text)}</div>`).join("");$("messages").scrollTop=$("messages").scrollHeight}
$("sendBtn").onclick=sendMessage;$("chatInput").addEventListener("keydown",e=>{if(e.key==="Enter")sendMessage()});
function sendMessage(){const text=$("chatInput").value.trim();if(!text||!activeChat)return;if(!chats[activeChat])chats[activeChat]=[];chats[activeChat].push({me:true,text});save();$("chatInput").value="";renderChats();setTimeout(()=>{const u=users.find(x=>x.id===activeChat);chats[activeChat].push({me:false,text:`Hey ${current.name.split(" ")[0]}! Great to connect. ✈️`});save();renderChats()},700)}
function escapeHtml(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function renderEvents(){$("eventsGrid").innerHTML=events.map(e=>`<article class="event"><div class="date">${e[0]}</div><h3>${e[1]}</h3><div style="font-size:10px;color:var(--red)">${e[2]}</div><p>${e[3]}</p><button onclick="toast('You are on the guest list for ${e[1]}')">Join Gathering</button></article>`).join("")}
function renderActivities(){$("activitiesGrid").innerHTML=activities.map(a=>`<article class="event"><div style="font-size:26px">${a[0]}</div><h3>${a[1]}</h3><p>${a[2]}</p><button onclick="toast('Activity joined — we will show you people with the same interest.')">Join Activity</button></article>`).join("")}
function renderProfile(){$("profileHero").textContent=initials(current.name);$("profileName").textContent=current.name;$("profileDetails").innerHTML=`<b style="color:#3e2723">${current.age} · ${current.role}</b><br>✓ Verified crew member<br>${current.airline} · ${current.location}<br><br>${current.about}<br><br><b>Interests</b><br>${current.tags.map(t=>`<span class="chip" style="display:inline-block;margin:4px 3px 0 0">${t}</span>`).join("")}`}
function logout(){current=null;activeChat=null;$("dashboard").style.display="none";$("landing").style.display="grid";showLogin();toast("Logged out")}
</script>
</body>
</html>
