{
  "app": "SkyConnection",
  "version": "5.1.0",
  "storage": "browser-demo-only",
  "maxMessageLength": 1000,
  "maxBioLength": 500,
  "maxImageBytes": 2097152,
  "maxDatabaseBytes": 4194304,
  "minPasswordLength": 10,
  "allowedImageTypes": [
    "image/jpeg",
    "image/png",
    "image/webp"
  ],
  "verification": {
    "mode": "server_required",
    "clientBypass": false,
    "documentsStoredClientSide": false
  },
  "security": {
    "passwordKdf": "PBKDF2-SHA-256",
    "iterations": 150000,
    "sessionStorage": true,
    "productionBackendRequired": true
  },
  "demo": {
    "loginHint": "Demo accounts are displayed in the UI; demo password is demo123."
  }
}
